---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './landing/Hero.astro';
import Plans from './landing/Plans.astro';
import FeatureGrid from './landing/FeatureGrid.astro';
import Trust from './landing/Trust.astro';
import Steps from './landing/Steps.astro';
import Faq from './landing/Faq.astro';
import Resources from './landing/Resources.astro';
import CallToAction from './CallToAction.astro';
import { landing } from '../data/landing';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = landing[locale];
const faqEntries = (await getCollection('faq', ({ data }) => data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);
const structuredData = [
  { '@type': 'Organization', name: 'Tamareel', url: 'https://tamareel.com/', logo: 'https://tamareel.com/images/icon.svg' },
  { '@type': 'WebSite', name: 'Tamareel', url: 'https://tamareel.com/', inLanguage: locale },
  { '@type': 'SoftwareApplication', name: 'Tamareel', url: 'https://tamareel.com/', applicationCategory: 'VideoApplication', operatingSystem: 'Web', description: content.seo.description },
];
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  locale={locale}
  image={content.seo.image}
  imageAlt={content.seo.imageAlt}
  headerMode="landing"
  structuredData={structuredData}
>
  <main id="top">
    <Hero content={content.hero} locale={locale} />
    <Plans content={content.plans} locale={locale} />
    <FeatureGrid content={content.features} />
    {content.trust && <Trust content={content.trust} />}
    <Steps content={content.steps} />
    <Faq content={content.faq} entries={faqEntries} />
    <Resources content={content.resources} />
    <CallToAction {...content.cta} locale={locale} />
  </main>
</BaseLayout>
