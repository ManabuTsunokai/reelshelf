---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from './Eyebrow.astro';
import { localizedPath, slugFromId, type Locale, ui } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const articles = (await getCollection('blog', ({ data }) => data.locale === locale))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title={`${t.blogTitle} | Tamareel`} description={t.blogDescription} locale={locale} path="/blog/">
  <main class="article-page">
    <div class="article-container container">
      <Eyebrow label="VIDEO GUIDE" />
      <h1>{t.blogTitle}</h1>
      <p class="article-lead">{t.blogDescription}</p>
      {articles.map((article) => (
        <a class:list={['content-card', { 'content-card-with-image': article.data.eyecatch }]} href={localizedPath(locale, `/blog/${slugFromId(article.id)}/`)}>
          {article.data.eyecatch && (
            <Image
              class="content-card-image"
              src={article.data.eyecatch}
              alt={article.data.eyecatchAlt ?? article.data.title}
              widths={[220, 440, 720, 1120]}
              sizes="(max-width: 760px) calc(100vw - 34px), 220px"
              format="webp"
              quality={82}
            />
          )}
          <div class="content-card-body">
            <Eyebrow label={article.data.eyebrow} />
            <h2>{article.data.title}</h2>
            <p>{article.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
