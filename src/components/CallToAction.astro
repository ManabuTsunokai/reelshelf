---
import { getSignupUrl } from '../data/site';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string[];
  lead: string;
  label: string;
  href?: string;
  trackingLocation?: string;
  secondary?: {
    label: string;
    href: string;
    trackingLocation?: string;
  };
}

const {
  locale,
  title,
  lead,
  label,
  href,
  trackingLocation = 'bottom',
  secondary,
} = Astro.props;
const resolvedHref = href ?? getSignupUrl(locale);
---

<section class="cta">
  <div class="container">
    <div class="cta-box">
      <h2>{title.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2>
      <p>{lead}</p>
      <div class="cta-actions">
        <a class="button" href={resolvedHref} data-ga-cta-location={trackingLocation}>{label} <span aria-hidden="true">→</span></a>
        {secondary && (
          <a
            class="cta-secondary-link"
            href={secondary.href}
            data-ga-cta-location={secondary.trackingLocation ?? `${trackingLocation}-secondary`}
          >
            {secondary.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
