---
import { site } from '../data/site';

interface Props { title: string[]; lead: string; label: string }
const { title, lead, label } = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="cta-box">
      <h2>{title.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2>
      <p>{lead}</p>
      <a class="button" href={site.signupUrl}>{label} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
