---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from './Eyebrow.astro';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props { locale: Locale }

const { locale } = Astro.props;
const privacyUrl = localizedPath(locale, '/privacy/');
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL ?? '';

const content = {
  ja: {
    title: 'お問い合わせ',
    description: 'Tamareelに関するご質問、ご要望、不具合についてお問い合わせいただけます。',
    lead: 'Tamareelについて気になることがありましたら、こちらからお知らせください。内容を確認のうえ、返信が必要なお問い合わせにはメールでご連絡します。',
    category: 'お問い合わせ種別',
    categoryPlaceholder: '選択してください',
    categories: [
      { value: 'question', label: 'サービスについての質問' },
      { value: 'feature_request', label: '機能の要望' },
      { value: 'bug_report', label: '不具合の報告' },
      { value: 'billing', label: '料金・契約について' },
      { value: 'other', label: 'その他' },
    ],
    name: 'お名前',
    optional: '任意',
    namePlaceholder: '山田 太郎',
    email: 'メールアドレス',
    emailHint: '返信を受け取れるメールアドレスをご入力ください。',
    emailPlaceholder: 'you@example.com',
    message: 'お問い合わせ内容',
    messagePlaceholder: 'お問い合わせ内容をできるだけ詳しくご記入ください。',
    privacyPrefix: '送信にあたり、',
    privacy: 'プライバシーポリシー',
    privacySuffix: 'に同意します。',
    submit: '送信する',
    sending: '送信しています…',
    sendError: '送信できませんでした。時間をおいて、もう一度お試しください。',
    unavailable: '現在、フォームからお問い合わせいただけません。',
    successTitle: 'お問い合わせを受け付けました',
    successMessage: 'お問い合わせありがとうございます。返信が必要な場合は、ご入力いただいたメールアドレスへご連絡します。',
    backHome: 'ホームへ戻る',
    required: '必須',
  },
  en: {
    title: 'Contact us',
    description: 'Contact Tamareel with questions, feedback, or issue reports.',
    lead: 'Have a question or feedback about Tamareel? Send us the details here. We will respond by email when a reply is needed.',
    category: 'Topic',
    categoryPlaceholder: 'Select a topic',
    categories: [
      { value: 'question', label: 'Question about the service' },
      { value: 'feature_request', label: 'Feature request' },
      { value: 'bug_report', label: 'Report a problem' },
      { value: 'billing', label: 'Pricing or subscription' },
      { value: 'other', label: 'Other' },
    ],
    name: 'Name',
    optional: 'Optional',
    namePlaceholder: 'Your name',
    email: 'Email address',
    emailHint: 'Enter an address where we can reach you.',
    emailPlaceholder: 'you@example.com',
    message: 'Message',
    messagePlaceholder: 'Tell us as much as you can about your question or issue.',
    privacyPrefix: 'I agree to the ',
    privacy: 'Privacy Policy',
    privacySuffix: '.',
    submit: 'Send message',
    sending: 'Sending…',
    sendError: 'Your message could not be sent. Please wait a moment and try again.',
    unavailable: 'The contact form is currently unavailable.',
    successTitle: 'Your message has been received',
    successMessage: 'Thank you for contacting us. If a reply is needed, we will contact you at the email address you provided.',
    backHome: 'Back to home',
    required: 'Required',
  },
} as const;

const t = content[locale];
---

<BaseLayout
  title={`${t.title} | Tamareel`}
  description={t.description}
  locale={locale}
  path="/contact/"
>
  <main class="contact-page">
    <div class="container contact-container">
      <section class="contact-intro">
        <Eyebrow label="CONTACT" />
        <h1>{t.title}</h1>
        <p class="contact-lead">{t.lead}</p>

      </section>

      <section class="contact-form-card" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title" class="sr-only">{t.title}</h2>
        <form
          class="contact-form"
          data-contact-form
          data-api-url={contactApiUrl}
          data-locale={locale}
          data-submit-label={t.submit}
          data-sending-label={t.sending}
          data-error-message={t.sendError}
        >
          <div class="contact-field">
            <label for="contact-category">
              {t.category}
              <span class="field-badge field-badge-required">{t.required}</span>
            </label>
            <div class="select-wrap">
              <select id="contact-category" name="category" required>
                <option value="" selected disabled>{t.categoryPlaceholder}</option>
                {t.categories.map((category) => <option value={category.value}>{category.label}</option>)}
              </select>
            </div>
          </div>

          <div class="contact-field">
            <label for="contact-name">
              {t.name}
              <span class="field-badge">{t.optional}</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder={t.namePlaceholder}
              maxlength="100"
            />
          </div>

          <div class="contact-field">
            <label for="contact-email">
              {t.email}
              <span class="field-badge field-badge-required">{t.required}</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              placeholder={t.emailPlaceholder}
              maxlength="254"
              aria-describedby="contact-email-hint"
              required
            />
            <p id="contact-email-hint" class="field-hint">{t.emailHint}</p>
          </div>

          <div class="contact-field">
            <label for="contact-message">
              {t.message}
              <span class="field-badge field-badge-required">{t.required}</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="8"
              placeholder={t.messagePlaceholder}
              maxlength="5000"
              required
            ></textarea>
          </div>

          <label class="contact-consent" for="contact-privacy">
            <input id="contact-privacy" name="privacy" type="checkbox" required />
            <span>
              {t.privacyPrefix}<a href={privacyUrl}>{t.privacy}</a>{t.privacySuffix}
            </span>
          </label>

          <div class="contact-honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <button class="contact-submit" type="submit" disabled={!contactApiUrl} data-contact-submit>
            <span data-contact-submit-label>{t.submit}</span>
            <span aria-hidden="true">→</span>
          </button>
          <p
            class="contact-status"
            data-contact-status
            data-state={contactApiUrl ? 'idle' : 'error'}
            role="status"
            aria-live="polite"
          >
            {!contactApiUrl && t.unavailable}
          </p>
        </form>

        <div class="contact-success" data-contact-success hidden tabindex="-1">
          <div class="contact-success-icon" aria-hidden="true">✓</div>
          <h2>{t.successTitle}</h2>
          <p>{t.successMessage}</p>
          <a class="button button-secondary" href={localizedPath(locale)}>{t.backHome}</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]')

  for (const form of forms) {
    if (form.dataset.initialized === 'true') continue
    form.dataset.initialized = 'true'

    const submitButton = form.querySelector<HTMLButtonElement>('[data-contact-submit]')
    const submitLabel = form.querySelector<HTMLElement>('[data-contact-submit-label]')
    const status = form.querySelector<HTMLElement>('[data-contact-status]')
    const success = form.parentElement?.querySelector<HTMLElement>('[data-contact-success]')

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (!form.reportValidity() || !submitButton || !submitLabel || !status || !success) {
        return
      }

      const apiUrl = form.dataset.apiUrl
      if (!apiUrl) return

      submitButton.disabled = true
      form.setAttribute('aria-busy', 'true')
      submitLabel.textContent = form.dataset.sendingLabel ?? ''
      status.textContent = ''
      status.dataset.state = 'idle'

      const formData = new FormData(form)
      const payload = {
        category: String(formData.get('category') ?? ''),
        name: String(formData.get('name') ?? ''),
        email: String(formData.get('email') ?? ''),
        message: String(formData.get('message') ?? ''),
        privacy: formData.get('privacy') === 'on',
        website: String(formData.get('website') ?? ''),
        locale: form.dataset.locale ?? 'ja',
      }

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        })

        if (!response.ok) {
          throw new Error(`Contact API returned ${response.status}`)
        }

        form.hidden = true
        success.hidden = false
        success.focus()
      } catch {
        submitButton.disabled = false
        submitLabel.textContent = form.dataset.submitLabel ?? ''
        status.textContent = form.dataset.errorMessage ?? ''
        status.dataset.state = 'error'
      } finally {
        form.removeAttribute('aria-busy')
      }
    })
  }
</script>
