---
import { getCollection } from 'astro:content';
import BlogArticle from '../../../components/BlogArticle.astro';
import { slugFromId } from '../../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => data.locale === 'en');
  return entries.map((entry) => ({ params: { slug: slugFromId(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BlogArticle entry={entry} />
