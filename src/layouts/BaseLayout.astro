---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPath, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  translations?: Locale[];
  headerMode?: 'landing' | 'internal';
  structuredData?: object | object[];
}

const {
  title,
  description,
  locale,
  path = '/',
  image,
  imageAlt = '',
  noindex = false,
  translations = ['ja', 'en'],
  headerMode = 'internal',
  structuredData,
} = Astro.props;
const canonical = new URL(localizedPath(locale, path), Astro.site);
const absoluteImage = image ? new URL(image, Astro.site) : undefined;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const graph = structuredData
  ? { '@context': 'https://schema.org', '@graph': Array.isArray(structuredData) ? structuredData : [structuredData] }
  : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    {gaMeasurementId && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){window.dataLayer.push(arguments);}
          window.gtag('js', new Date());
          window.gtag('config', gaMeasurementId);

          document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const cta = target.closest('[data-ga-cta-location]');
            if (!(cta instanceof HTMLAnchorElement)) return;

            window.gtag('event', 'cta_click', {
              cta_location: cta.dataset.gaCtaLocation,
              language: document.documentElement.lang,
              link_url: cta.href,
            });
          });
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/images/icon.svg" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {translations.map((translation) => (
      <link rel="alternate" hreflang={translation} href={new URL(localizedPath(translation, path), Astro.site)} />
    ))}
    {translations.includes('ja') && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('ja', path), Astro.site)} />}
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tamareel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <Header locale={locale} path={path} mode={headerMode} translations={translations} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
